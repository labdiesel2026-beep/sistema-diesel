# Variables de entorno — Laboratorio Diésel MVP
# Copiar este archivo como .env y completar los valores requeridos.

# ==========================================
# 1. Base de Datos (PostgreSQL - Docker)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=laboratorio_diesel
POSTGRES_PORT=5432

# Cadena de conexión para Prisma ORM / PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/laboratorio_diesel?schema=public"

# ==========================================
# 2. Frontend / API Client (Vite)
# ==========================================
VITE_API_URL=http://localhost:3001
VITE_CONTACT_WHATSAPP=5492657659108
